# For Docker + Nginx reverse proxy architecture (Recommended):
# Directs API requests through Nginx proxy pass (/api/v1 -> backend:8000/api/v1)
NEXT_PUBLIC_API_URL=/api/v1

# For external subdomain deployment (Optional alternate topology):
# NEXT_PUBLIC_API_URL=https://api.crm.kiwicloudtech.co.in/api/v1
