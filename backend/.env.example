# ============================================================
# KIWI CLOUD TECH CRM - BACKEND ENVIRONMENT VARIABLES
# ============================================================
#
# Environment Mode: "production" or "development"
ENVIRONMENT=production
PROJECT_NAME=Kiwi Cloud Tech CRM

# JWT Security (Must be at least 32 characters in production)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database URL
# For Render PostgreSQL (Internal or External URL from Render Dashboard):
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/database_name
# (Note: postgres:// and postgresql:// prefixes are automatically converted to postgresql+psycopg://)
#
# For Local Development with SQLite:
# DATABASE_URL=sqlite:///./crm.db
DATABASE_URL=

# CORS Origins (Comma-separated list of allowed frontend origins)
# For Render + Vercel: include your Vercel URL
# Example: https://your-project.vercel.app,https://crm.kiwicloudtech.co.in
CORS_ORIGINS=https://crm.kiwicloudtech.co.in
BACKEND_CORS_ORIGINS=https://crm.kiwicloudtech.co.in

# Redis Configuration (Optional / Background tasks)
# REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_COMM_PER_MINUTE=20

# Mail Configuration (Hostinger SMTP/IMAP or provider-neutral)
MAIL_PROVIDER=none
MAIL_FROM_NAME=Kiwi Cloud Tech
MAIL_FROM_ADDRESS=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=none
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=none
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=

# Communications
COMM_NOTIFICATION_EMAILS_ENABLED=false

# WhatsApp Business API (Optional)
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# Telephony (Optional)
TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=none
TELEPHONY_BUSINESS_NUMBER=

# AI Assistant ("mock", "openai", or "gemini")
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_PROMPT_LENGTH=2000
AI_MAX_TOOL_RESULTS=10
