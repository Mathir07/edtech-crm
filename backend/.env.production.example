# ============================================================
# KIWI CLOUD TECH CRM - BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# Domain: kiwicloudtech.co.in
# File: backend/.env.production.example
# ============================================================

# Environment Mode ("production" or "development")
ENVIRONMENT=production
PROJECT_NAME=Kiwi Cloud Tech CRM

# JWT Security (Must be at least 32 characters in production)
# IMPORTANT: Generate a secure random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Database (PostgreSQL with psycopg driver)
# Connects to Docker PostgreSQL service via service name "db"
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_POSTGRES_PASSWORD@db:5432/edtech_crm

# Postgres Credentials (Must match DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=edtech_crm

# Database Connection Pooling (Production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Redis Configuration (Internal Docker service)
REDIS_URL=redis://redis:6379/0

# CORS Configuration (Must include production frontend domains)
BACKEND_CORS_ORIGINS=https://crm.kiwicloudtech.co.in,http://localhost

# Frontend API URL (Relative path for Nginx reverse proxy architecture)
NEXT_PUBLIC_API_URL=/api/v1

# Production Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_COMM_PER_MINUTE=20

# ============================================================
# OPTIONAL INTEGRATIONS (Configure when credentials are available)
# ============================================================

# Mail Configuration (Hostinger SMTP & IMAP or provider-neutral)
MAIL_PROVIDER=none
MAIL_FROM_NAME=Kiwi Cloud Tech
MAIL_FROM_ADDRESS=

MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=none
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=none
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=

# Communications & Notifications Dispatch
COMM_NOTIFICATION_EMAILS_ENABLED=false

# WhatsApp Business API (Meta Cloud API / BSP)
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# Telephony Configuration (Provider-Neutral)
TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=none
TELEPHONY_BUSINESS_NUMBER=

# AI Assistant Configuration ("mock", "openai", or "gemini")
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_PROMPT_LENGTH=2000
AI_MAX_TOOL_RESULTS=10
