# ============================================================
# KIWI CLOUD TECH CRM - BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# Domain: kiwicloudtech.co.in
# File: backend/.env.production.example
# ============================================================

# Environment Mode
ENVIRONMENT=production
PROJECT_NAME=Kiwi Cloud Tech CRM

# JWT Security (Must be at least 32 characters in production)
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16 with psycopg driver)
# Connects to Docker PostgreSQL service via service name "db"
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_POSTGRES_PASSWORD@db:5432/edtech_crm

# Postgres Credentials (Must match DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=edtech_crm

# Database Connection Pooling (Production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# CORS Configuration (Must include the production frontend domain)
BACKEND_CORS_ORIGINS=https://crm.kiwicloudtech.co.in

# Production Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_COMM_PER_MINUTE=20

# Mail Configuration (Disabled / Not Configured)
MAIL_PROVIDER=none
MAIL_FROM_NAME=Kiwi Cloud Tech
MAIL_FROM_ADDRESS=

MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=none
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=none
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=

# Communications & Notifications Dispatch
COMM_NOTIFICATION_EMAILS_ENABLED=false

# Telephony Configuration (Provider-Neutral / Disabled for Initial Release)
TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=none
TELEPHONY_BUSINESS_NUMBER=

# AI Assistant Configuration (Phase 12 / Default mock mode)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_PROMPT_LENGTH=2000
AI_MAX_TOOL_RESULTS=10
