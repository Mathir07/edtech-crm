# ============================================================
# KIWI CLOUD TECH CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# Domain: kiwicloudtech.co.in
# ============================================================

# Environment: "development" or "production"
ENVIRONMENT=development

# Database Configuration (PostgreSQL 16 with psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edtech_crm

# PostgreSQL Configuration Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edtech_crm

# Database Connection Pooling (Production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# JWT Security (Must be at least 32 characters in production)
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (Optional / Background task queue)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (Comma-separated list or JSON array of allowed origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Rate Limiting Configuration (Requests per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_COMM_PER_MINUTE=20

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ============================================================
# COMMUNICATIONS & EXTERNAL INTEGRATIONS
# ============================================================

# Company Mail (Hostinger SMTP & IMAP)
MAIL_PROVIDER=hostinger
MAIL_FROM_NAME=Kiwi Cloud Tech
MAIL_FROM_ADDRESS=info@kiwicloudtech.co.in

MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=ssl
MAIL_SMTP_USERNAME=info@kiwicloudtech.co.in
MAIL_SMTP_PASSWORD=

MAIL_IMAP_HOST=imap.hostinger.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=ssl
MAIL_IMAP_USERNAME=info@kiwicloudtech.co.in
MAIL_IMAP_PASSWORD=

# Telephony Configuration (Provider-Neutral Foundation)
TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=none
TELEPHONY_BUSINESS_NUMBER=

# In-App & Email Notification Dispatch
COMM_NOTIFICATION_EMAILS_ENABLED=false

# WhatsApp Business API (Meta Cloud API / BSP)
WHATSAPP_PROVIDER=META_CLOUD
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# ============================================================
# AI ASSISTANT CONFIGURATION (Phase 12)
# ============================================================
# Provider options: "mock" (default, local safe testing), "openai", "gemini"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_PROMPT_LENGTH=2000
AI_MAX_TOOL_RESULTS=10
