# ============================================================
# KIWI CLOUD TECH CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# Domain: kiwicloudtech.co.in
# ============================================================

# Environment: "development" or "production"
ENVIRONMENT=development

# Database Configuration
# Local Development with SQLite:
# DATABASE_URL=sqlite:///./crm.db
# Local Development with PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edtech_crm
# Production / Docker Deployment (uses internal Docker service "db"):
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_password_replace_in_prod@db:5432/edtech_crm

# Database Connection Pooling (Production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Postgres Docker Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod
POSTGRES_DB=edtech_crm

# JWT Security (Must be at least 32 characters in production)
# IMPORTANT: Replace with a secure random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (Optional / Background task queue)
# For Docker deployment: redis://redis:6379/0
# For local host without Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# CORS Configuration (Comma-separated list or JSON array of allowed origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://localhost

# Rate Limiting Configuration (Requests per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_COMM_PER_MINUTE=20

# Frontend Configuration
# For Docker + Nginx reverse proxy architecture: /api/v1
# For standalone local dev frontend (port 3000 -> 8000): http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# ============================================================
# COMMUNICATIONS & EXTERNAL INTEGRATIONS
# ============================================================

# Company Mail (Hostinger SMTP & IMAP)
MAIL_PROVIDER=hostinger
MAIL_FROM_NAME=Kiwi Cloud Tech
MAIL_FROM_ADDRESS=info@kiwicloudtech.co.in

MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=ssl
MAIL_SMTP_USERNAME=info@kiwicloudtech.co.in
MAIL_SMTP_PASSWORD=

MAIL_IMAP_HOST=imap.hostinger.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=ssl
MAIL_IMAP_USERNAME=info@kiwicloudtech.co.in
MAIL_IMAP_PASSWORD=

# Telephony Configuration (Provider-Neutral Foundation)
TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=none
TELEPHONY_BUSINESS_NUMBER=

# In-App & Email Notification Dispatch
COMM_NOTIFICATION_EMAILS_ENABLED=false

# WhatsApp Business API (Meta Cloud API / BSP)
WHATSAPP_PROVIDER=META_CLOUD
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# ============================================================
# AI ASSISTANT CONFIGURATION (Phase 12)
# ============================================================
# Provider options: "mock" (default, local safe testing), "openai", "gemini"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_PROMPT_LENGTH=2000
AI_MAX_TOOL_RESULTS=10
